# Copie este arquivo para .env.local e preencha.

# --- Inteligência artificial (Claude, da Anthropic) ---
# Chave criada em https://platform.claude.com — sem ela o plano sai na versão
# padrão (sem o texto personalizado por IA).
ANTHROPIC_API_KEY=
# Opcional: troque o modelo usado para escrever o plano.
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Pagamento (Mercado Pago, Checkout Pro) ---
# Access Token de produção: Mercado Pago > Seu negócio > Configurações >
# Credenciais. Com ele preenchido, o site cobra de verdade.
MERCADOPAGO_ACCESS_TOKEN=
# Sem o token acima, use "teste" para simular o pagamento (o plano fica
# liberado sem cobrar). NUNCA deixe "teste" no site publicado.
PAGAMENTO_MODO=teste

# --- Site ---
# Endereço público do site (sem barra no final). Usado na volta do pagamento.
# SITE_URL=https://seudominio.com.br
# E-mail de atendimento mostrado no rodapé, na garantia e na privacidade.
NEXT_PUBLIC_CONTATO_EMAIL=contato@seudominio.com.br
